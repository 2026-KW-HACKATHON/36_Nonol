{
  "name": "nonol-alpha",
  "private": true,
  "version": "0.1.0",
  "description": "묵언수행 알파 트랙 소개와 참가 신청",
  "scripts": {
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "dev": "npm run db:migrate && wrangler dev --port 8789",
    "deploy": "npm run db:migrate:remote && wrangler deploy",
    "check": "node --check src/worker.js && node --check public/v2/app.js"
  },
  "devDependencies": {
    "wrangler": "4.132.0"
  }
}
